# GEMINI_API_KEY: Stored in Google Cloud Secret Manager as 'GEMINI_API_KEY'.
# In production on Cloud Run, this secret is securely mounted/injected into the container
# environment via Cloud Run Secret Manager integration (--set-secrets="GEMINI_API_KEY=GEMINI_API_KEY:latest").
# The Cloud Run runtime service account requires 'roles/secretmanager.secretAccessor' on this secret.
# NEVER commit raw secret values or keys to source control.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# Injected at runtime with the Cloud Run service URL.
APP_URL=""
